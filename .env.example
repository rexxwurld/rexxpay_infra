# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=your_mongodb_connection_string

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Webhook signing - used to verify incoming "payment succeeded" webhooks.
# Must be IDENTICAL to BANK_WEBHOOK_SECRET set on RexxPay Bank.
BANK_WEBHOOK_SECRET=replace_with_a_long_random_secret

# ================= REXXPAY BANK INTEGRATION =================
# RexxPay Bank (the real wallet system) - used to provision real pool
# accounts instead of locally-generated fake ones.
REXXPAY_BANK_BASE_URL=https://rexxpay.onrender.com

# Must match ADMIN_KEY set on RexxPay Bank.
REXXPAY_BANK_ADMIN_KEY=replace_with_a_long_random_secret

# API keys are generated per merchant at signup, not set here.

# ================= OPERATOR / ADMIN =================
# Guards the /api/admin/* routes (provision-pool, pool-status). Fails
# closed - if unset, admin routes reject every request with a 500.
INFRA_ADMIN_KEY=replace_with_a_long_random_secret

# ================= RISK & COMPLIANCE =================
# Comma-separated full names (case-insensitive) to test the sanctions-hit
# flagging path locally. Dev-only stand-in for a real screening provider -
# see utils/sanctionsCheck.js. Leave empty/unset in normal dev use.
SANCTIONS_DENYLIST_DEV=

# All optional - override the defaults baked into config/limits.js.
# Amounts are in minor units (kobo).
MAX_SINGLE_PAYMENT_MINOR=50000000
MAX_DAILY_INBOUND_MINOR=500000000
VELOCITY_WINDOW_MINUTES=10
VELOCITY_MAX_COUNT=5
MAX_SINGLE_PAYOUT_MINOR=200000000
VIRTUAL_ACCOUNT_EXPIRY_MINUTES=60
DISPUTE_EVIDENCE_WINDOW_DAYS=7

# ================= ACCOUNT POOL AUTO-TOPUP =================
# All optional - override the defaults baked into config/limits.js.
# If a bank partner's available-account count drops at or below
# POOL_MIN_THRESHOLD, POOL_TOPUP_COUNT new accounts are provisioned for
# that bank (see scripts/auto-provision-pool.js).
POOL_MIN_THRESHOLD=20
POOL_TOPUP_COUNT=20

# ================= PLATFORM FEES =================
# All optional - override the defaults baked into config/fees.js.
# What RexxPay charges merchants per transaction.
PLATFORM_FEE_BPS=150
PLATFORM_FEE_FIXED_MINOR=10000
PLATFORM_FEE_CAP_MINOR=200000
