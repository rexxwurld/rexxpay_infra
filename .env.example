# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=your_mongodb_connection_string

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Webhook signing (used by the mock bank partner to sign callbacks,
# and by your webhook receiver to verify them)
BANK_WEBHOOK_SECRET=replace_with_a_long_random_secret

# API keys are generated per merchant at signup, not set here.
